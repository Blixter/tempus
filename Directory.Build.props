<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Versioning: bump VersionPrefix for the next release. CI/scripts override with -p:Version=x.y.z -->
    <VersionPrefix>0.2.4</VersionPrefix>

    <!-- Package metadata shared by every package -->
    <Authors>Robin Blixter</Authors>
    <Copyright>Copyright (c) 2026 Robin Blixter</Copyright>
    <Description>Tempus - an open source background job scheduler and workflow library for .NET.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Blixter/tempus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Blixter/tempus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>scheduler;cron;background-jobs;jobs;workflow;tickerq;hangfire-alternative</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Only projects under src/ are packed -->
    <IsPackable>false</IsPackable>

    <!-- Source Link + symbol packages -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
