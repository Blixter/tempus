<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Tempus.Integrations</RootNamespace>
    <PackageId>Blixter.Tempus.Integrations</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Slack, Microsoft Teams and webhook failure alerts for Tempus.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tempus/Tempus.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.22" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>
</Project>
