<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Tempus</RootNamespace>
    <PackageId>Blixter.Tempus</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Tempus core: background job scheduler with one-time jobs, cron jobs, chains, schedule policies, retries and an in-memory store.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tempus.Tests" />
    <InternalsVisibleTo Include="Tempus.Dashboard" />
    <InternalsVisibleTo Include="Tempus.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Tempus.Integrations" />
  </ItemGroup>
</Project>
